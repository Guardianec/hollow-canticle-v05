{
  "name": "hollow-canticle",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A procedural dungeon crawler about the space between two strikes.",
  "scripts": {
    "assets:build": "node tools/assets-build.mjs",
    "assets:validate": "node tools/validate-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write src tests *.json *.ts *.js *.md docs .github",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc --noEmit -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start:server": "node dist-server/index.mjs",
    "test:server": "vitest run tests/server",
    "test:load": "tsx tools/online-load.ts",
    "net:proxy": "node tools/latency-proxy.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.42",
    "@colyseus/sdk": "0.18.6",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "colyseus": "0.18.10",
    "meshoptimizer": "^1.3.0",
    "phaser": "4.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@colyseus/testing": "0.18.6",
    "@eslint/js": "9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
