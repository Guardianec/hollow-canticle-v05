{
  "name": "hollow-canticle",
  "version": "0.5.0-benchmark",
  "private": true,
  "type": "module",
  "description": "A procedural dungeon crawler about the space between two strikes.",
  "scripts": {
    "assets:build": "node tools/assets-build.mjs",
    "assets:validate": "node tools/validate-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write src tests *.json *.ts *.js *.md docs .github"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "phaser": "4.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
